rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      let chatPath = /databases/(default)/documents/chats/$(chatId);
      return isSignedIn()
             && firestore.exists(chatPath)
             && firestore.get(chatPath).data.participants is list
             && request.auth.uid in firestore.get(chatPath).data.participants;
    }

    function isGroupParticipant(groupId) {
      let groupPath = /databases/(default)/documents/groups/$(groupId);
      return isSignedIn()
             && firestore.exists(groupPath)
             && firestore.get(groupPath).data.members is list
             && request.auth.uid in firestore.get(groupPath).data.members;
    }

    function validSpotMediaRelationship(ownerUid, viewerUid, feedData) {
      return (
               'chatId' in feedData
               && feedData.chatId is string
               && firestore.exists(/databases/(default)/documents/chats/$(feedData.chatId))
               && ownerUid in firestore.get(/databases/(default)/documents/chats/$(feedData.chatId)).data.participants
               && viewerUid in firestore.get(/databases/(default)/documents/chats/$(feedData.chatId)).data.participants
             )
             || (
               'groupId' in feedData
               && feedData.groupId is string
               && firestore.exists(/databases/(default)/documents/groups/$(feedData.groupId))
               && ownerUid in firestore.get(/databases/(default)/documents/groups/$(feedData.groupId)).data.members
               && viewerUid in firestore.get(/databases/(default)/documents/groups/$(feedData.groupId)).data.members
             );
    }

    function canReadSpotMedia(uid, spotId) {
      let feedPath = /databases/(default)/documents/spotFeeds/$(request.auth.uid)/items/$(spotId);
      return isSignedIn()
             && (
               request.auth.uid == uid
               || (
                 firestore.exists(feedPath)
                 && firestore.get(feedPath).data.ownerUid == uid
                 && firestore.get(feedPath).data.expiresAt > request.time
                 && validSpotMediaRelationship(uid, request.auth.uid, firestore.get(feedPath).data)
               )
             );
    }

    function underSizeLimit(maxMB) {
      return request.resource.size < maxMB * 1024 * 1024;
    }

    function underEncryptedSizeLimit(maxMB) {
      return request.resource.size <= maxMB * 1024 * 1024 + 16;
    }

    // Profile photos remain visible to signed-in users; writes are owner-only.
    match /profile-photos/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && (
                     request.resource == null
                     || (
                       request.resource.size < 5 * 1024 * 1024
                       && request.resource.contentType.matches('image/.*')
                     )
                   );
    }

    // Chat and group objects contain encrypted bytes only.
    match /chats/{chatId}/{fileName} {
      allow read: if isChatParticipant(chatId);
      allow write: if isChatParticipant(chatId)
                   && (
                     request.resource == null
                     || (
                       underEncryptedSizeLimit(50)
                       && request.resource.contentType == 'application/octet-stream'
                     )
                   );
    }

    match /groups/{groupId}/{fileName} {
      allow read: if isGroupParticipant(groupId);
      allow write: if isGroupParticipant(groupId)
                   && (
                     request.resource == null
                     || (
                       underEncryptedSizeLimit(50)
                       && request.resource.contentType == 'application/octet-stream'
                     )
                   );
    }

    // Spot media is scoped to the author and the validated per-viewer feed.
    match /spots/{uid}/{spotId}/{fileName} {
      allow read: if canReadSpotMedia(uid, spotId);
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && (
                     request.resource == null
                     || (
                       underSizeLimit(50)
                       && request.resource.contentType.matches('(image|video)/.*')
                     )
                   );
    }

    match /spots/{uid}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
