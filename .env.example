# Copy this file to .env.local and fill in your own Firebase project values.
# Get these from Firebase Console > Project Settings > General > Your apps > SDK setup.
# NEVER commit the real .env.local file.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only needed once Cloud Messaging (push notifications) is wired up in a later phase
VITE_FIREBASE_VAPID_KEY=

# URL of the Node backend in /server (LiveKit tokens + YouTube Live). Defaults to localhost in dev.
VITE_BACKEND_URL=http://localhost:8080
