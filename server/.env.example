# --- Server ---
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# --- Firebase Admin (for verifying ID tokens + reading/writing Firestore as a trusted server) ---
# Generate at: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the ENTIRE downloaded JSON as a single line here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- LiveKit (meeting SFU) ---
# From your LiveKit Cloud project (or self-hosted server) settings.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# --- YouTube Live (Google Cloud project with YouTube Data API v3 enabled) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID (Web application)
# Authorized redirect URI must exactly match YOUTUBE_REDIRECT_URI below.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/youtube/oauth-callback

# --- GI AI (optional — chat/meeting summarization, called only on-demand) ---
# An API key for your LLM provider. Defaults to calling Anthropic's Messages API.
GI_AI_API_KEY=
GI_AI_MODEL=claude-sonnet-4-6
